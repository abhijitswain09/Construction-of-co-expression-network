params {
    input = null
    sample_columns = '8,14,15,5,6,7'
    outdir = 'results'
}
process {
    publishDir = [path: params.outdir, mode: 'copy']
    errorStrategy = 'terminate'
}
profiles {
    standard { process.executor = 'local' }
    conda { conda.enabled = true }
    test { includeConfig 'conf/test.config' }
}
